# ==============================================================================
# AuditLens - environment configuration
#
# Copy to .env for local runs. Every variable is optional: with none set, the
# app starts with sign-in on and its defaults. Never commit the real .env file.
# On AWS these are set on the ECS Express Mode service (docs/DEPLOYMENT.md).
# ==============================================================================

# Sign-in for review endpoints. Keep true anywhere others can reach the app;
# false is for local testing only
AUTH_REQUIRED=true

# Hours a sign-in lasts
AUTH_TOKEN_HOURS=12

# Where the SQLite file lives (the container uses /app/var/finsight_review.db)
SQLITE_DB_PATH=finsight_review.db

# An account recreated whenever the app starts.
#
# The database above is a file inside the container, so a deployment replaces
# it and every account registered before that deployment is gone. Setting these
# means one known account always exists, and a deployment no longer signs the
# team out of the live service. An account somebody registered themselves is
# never overwritten.
#
# Leave the password empty and nothing is seeded - which is what you want
# locally. On AWS it is set on the service, not in this file, and never
# committed. The role must be one the sign-up form offers.
SEED_ACCOUNT_EMAIL=
SEED_ACCOUNT_PASSWORD=
SEED_ACCOUNT_NAME=
SEED_ACCOUNT_ROLE=Senior Financial Auditor

# Largest upload accepted, in MB
MAX_UPLOAD_MB=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Leave both empty. By team decision no hosted AI service is used; if a key is
# set, Data Ingestion's column mapper sends column names and sample values to it.
GEMINI_API_KEY=
OPENAI_API_KEY=
