# ==============================================================================
# FinSight AI - environment configuration
#
# Copy to .env and fill in what you need. Every variable is optional: with none
# of them set, the application runs its offline heuristic reviewer and stays
# fully functional. Never commit the real .env file.
# ==============================================================================

# Which AI provider to use: gemini | openai | heuristic
LLM_PROVIDER=heuristic

# Provider credentials. In AWS these come from Secrets Manager, not from here.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Where the SQLite file lives
SQLITE_DB_PATH=finsight_review.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Sign-in for review endpoints. Keep true anywhere others can reach the app;
# false is for local testing only
AUTH_REQUIRED=true

# Hours a sign-in lasts
AUTH_TOKEN_HOURS=12

# AWS - used for report storage and log shipping
AWS_REGION=ap-south-1
S3_REPORT_BUCKET=
